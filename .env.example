# ==============================================================================
# FINORA FINANCIAL OS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and insert your real production or developer secrets.
# IMPORTANT: .env is git-ignored and must NEVER be committed to version control.
# IMPORTANT: The market data API key is only used by the backend service.
#            NEVER prefix with VITE_ to prevent client-side bundle leakage.
# ==============================================================================

# Finnhub Financial Market Data Provider
# Obtain your free or pro API key at: https://finnhub.io
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Optional Port for standalone market data server (defaults to 3001)
MARKET_SERVER_PORT=3001

