# ==============================================================================
# TÍCH SẢN FINANCIAL OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép tệp này thành .env và điền các API keys của dịch vụ thực tế.
# QUY TẮC BẢO MẬT: .env được git-ignore và TUYỆT ĐỐI KHÔNG commit lên repo.
# ==============================================================================

# =====================================
# 1. APPLICATION
# =====================================
APP_NAME=TICHSAN
APP_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5173/api
APP_TIMEZONE=Asia/Ho_Chi_Minh

# =====================================
# 2. DATABASE & STORAGE
# =====================================
# Mặc định sử dụng Local-First JSON Encrypted Enclave (.data/finora_db.json)
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=10

# =====================================
# 3. REDIS (Tùy chọn cho Caching & Rate Limit)
# =====================================
REDIS_URL=

# =====================================
# 4. AUTHENTICATION & SESSIONS
# =====================================
JWT_ACCESS_SECRET=TichSan_Jwt_Access_Secret_Key_Change_In_Production_382941
REFRESH_TOKEN_PEPPER=TichSan_Pepper_2026_Secure_Enclave_Salt_998
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_SESSION_MAX_AGE_DAYS=120
AUTH_REFRESH_TOKEN_ROTATION=true

# =====================================
# 5. EMAIL / SMTP (Xác minh & Đặt lại mật khẩu)
# =====================================
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hotro@tichsan.vn
SMTP_FROM_NAME=Tich San Support

# Nhà cung cấp Email thay thế (Resend API)
RESEND_API_KEY=

# =====================================
# 6. GOOGLE OAUTH
# =====================================
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# =====================================
# 7. FACEBOOK OAUTH
# =====================================
FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5173/api/auth/facebook/callback

# =====================================
# 8. SUBSCRIPTION & TRIAL POLICY
# =====================================
DEFAULT_PLAN_CODE=FREE
WELCOME_GIFT_PLAN_CODE=VIP_GOLD
WELCOME_GIFT_DAYS=30
FEATURE_TOPUP_ENABLED=false

# =====================================
# 9. PAYOS PAYMENT GATEWAY & LEGAL GATE
# =====================================
# Chế độ mặc định AN TOÀN PHÁP LÝ: Tạm dừng thu tiền thật cho đến khi hoàn tất
# nghĩa vụ đăng ký kinh doanh, thuế GTGT (Luật 149/2025/QH15) và hóa đơn (NĐ 70/2025/NĐ-CP).
PAYMENTS_ENABLED=false
PAYOS_ENABLED=false
LEGAL_COMPLIANCE_APPROVED=false

# Cấu hình PayOS khi đủ điều kiện pháp lý để kích hoạt:
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=http://localhost:5173/api/payment/webhook

# =====================================
# 10. ADMIN BOOTSTRAP CLI
# =====================================
ADMIN_BOOTSTRAP_EMAIL=admin@tichsan.vn
ADMIN_BOOTSTRAP_COOLDOWN_DAYS=7

# =====================================
# 11. FINANCIAL MARKET DATA (Finnhub)
# =====================================
# Đăng ký nhận API key miễn phí tại: https://finnhub.io
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
MARKET_SERVER_PORT=3001

# =====================================
# 12. AI SERVICES (Google Gemini / OpenAI)
# =====================================
AI_PROVIDER=gemini
AI_API_KEY=

# =====================================
# 13. S3 OBJECT STORAGE (Sao lưu & File đính kèm)
# =====================================
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =====================================
# 14. MONITORING & AUDIT
# =====================================
SENTRY_DSN=
