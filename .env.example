# ==============================================================================
# TÍCH SẢN FINANCIAL OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép tệp này thành .env và điền các API keys của dịch vụ thực tế.
# QUY TẮC BẢO MẬT: .env được git-ignore và TUYỆT ĐỐI KHÔNG commit lên repo.
# ==============================================================================

# =====================================
# 1. APPLICATION
# =====================================
APP_NAME=TICHSAN
APP_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5173/api
APP_TIMEZONE=Asia/Ho_Chi_Minh

# =====================================
# 2. DATABASE & STORAGE
# =====================================
# Mặc định sử dụng Local-First JSON Encrypted Enclave (.data/finora_db.json)
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=10

# =====================================
# 3. REDIS (Tùy chọn cho Caching & Rate Limit)
# =====================================
REDIS_URL=

# =====================================
# 4. AUTHENTICATION & SESSIONS
# =====================================
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY
REFRESH_TOKEN_PEPPER=REPLACE_WITH_SECURE_64_CHAR_HEX_PEPPER
VITE_LEASE_SALT=REPLACE_WITH_SECURE_64_CHAR_HEX_SALT
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_SESSION_MAX_AGE_DAYS=120
AUTH_REFRESH_TOKEN_ROTATION=true

# =====================================
# 5. EMAIL / SMTP (Xác minh & Đặt lại mật khẩu)
# =====================================
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hotro@tichsan.site
SMTP_FROM_NAME=Tich San Support

# Nhà cung cấp Email thay thế (Resend API)
RESEND_API_KEY=

# =====================================
# 6. GOOGLE OAUTH
# =====================================
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# =====================================
# 7. FACEBOOK OAUTH
# =====================================
FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5173/api/auth/facebook/callback

# =====================================
# 8. SUBSCRIPTION & TRIAL POLICY
# =====================================
DEFAULT_PLAN_CODE=FREE
WELCOME_GIFT_PLAN_CODE=VIP_GOLD
WELCOME_GIFT_DAYS=30
FEATURE_TOPUP_ENABLED=false

# =====================================
# 9. PAYOS PAYMENT GATEWAY & LEGAL GATE
# =====================================
# Chế độ mặc định AN TOÀN PHÁP LÝ: Tạm dừng thu tiền thật cho đến khi hoàn tất
# nghĩa vụ đăng ký kinh doanh, thuế GTGT (Luật 149/2025/QH15) và hóa đơn (NĐ 70/2025/NĐ-CP).
PAYMENTS_ENABLED=false
PAYOS_ENABLED=false
LEGAL_COMPLIANCE_APPROVED=false

# Cấu hình PayOS khi đủ điều kiện pháp lý để kích hoạt:
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=http://localhost:5173/api/payment/webhook

# =====================================
# 10. ADMIN BOOTSTRAP CLI
# =====================================
ADMIN_BOOTSTRAP_EMAIL=admin@tichsan.site
ADMIN_BOOTSTRAP_COOLDOWN_DAYS=7
ADMIN_SECURITY_KEY=REPLACE_WITH_SECURE_ADMIN_MASTER_KEY

# =====================================
# 11. FINANCIAL MARKET DATA (Finnhub)
# =====================================
# Đăng ký nhận API key miễn phí tại: https://finnhub.io
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
MARKET_SERVER_PORT=3001

# =====================================
# 12. AI SERVICES (Google Gemini / OpenAI)
# =====================================
AI_PROVIDER=gemini
AI_API_KEY=

# =====================================
# 13. S3 OBJECT STORAGE (Sao lưu & File đính kèm)
# =====================================
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =====================================
# 14. MONITORING & AUDIT
# =====================================
SENTRY_DSN=

# =====================================
# 15. FIREBASE AUTH (Google & Facebook Sign-In)
# =====================================
# Đăng ký Firebase console: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# =====================================
# 16. TELEGRAM NOTIFICATION BOT
# =====================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FinoraFinanceBot

# =====================================
# 17. OPEN BANKING & TRANSACTION SYNC (Casso / SePay / NAPAS)
# =====================================
BANKING_PROVIDER=casso
BANKING_CLIENT_ID=
BANKING_CLIENT_SECRET=
BANKING_WEBHOOK_URL=http://localhost:5173/api/banking/webhook
BANKING_WEBHOOK_SECRET=

# =====================================
# 18. SMART QR & AUTOMATIC PAYMENT CONFIRMATION
# =====================================
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
VIETQR_LOOKUP_ENABLED=true
SMART_QR_AUTO_CONFIRM_THRESHOLD=0.85
SMART_QR_INTENT_TTL_MINUTES=30
NOTIFICATION_LISTENER_SECRET=

# =====================================
# 19. SMART RECEIPT & OCR ENGINE
# =====================================
OCR_PROVIDER=gemini
OCR_API_KEY=
RECEIPT_AUTO_CATEGORIZE=true

