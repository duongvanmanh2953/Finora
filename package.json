{
  "name": "tich-loc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:landing": "vite --host 0.0.0.0 --port 3001 --open /landing",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --no-file-parallelism",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:build": "npm run build && npx cap sync android && ./android/gradlew -p android assembleDebug && cp android/app/build/outputs/apk/debug/app-debug.apk public/downloads/finora-latest.apk",
    "admin:reset": "tsx src/server/admin/adminResetCli.ts",
    "admin:update": "tsx src/server/admin/adminResetCli.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-charts": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.23",
    "driver.js": "^1.10.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^7.6.10",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
