# ==============================================================================
# TÍCH SẢN — PRODUCTION ENVIRONMENT SPECIFICATION TEMPLATE
# ==============================================================================
# Điền đầy đủ các thông số production trước khi triển khai container hoặc VPS.
# ==============================================================================

APP_NAME=TICHSAN
APP_ENV=production
APP_URL=https://tichsan.vn
API_URL=https://tichsan.vn/api
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Database
DATABASE_URL=
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Cache & Sessions
REDIS_URL=redis://default:STRONG_PASSWORD@redis:6379/0

# Production JWT & Sessions (120-Day Rotating Engine)
JWT_ACCESS_SECRET=REPLACE_WITH_A_SUPER_STRONG_64_CHAR_HEX_SECRET_IN_PROD
REFRESH_TOKEN_PEPPER=REPLACE_WITH_A_HARD_RANDOM_PEPPER_FOR_REFRESH_TOKENS
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_SESSION_MAX_AGE_DAYS=120
AUTH_REFRESH_TOKEN_ROTATION=true

# Email SMTP Production
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_production_key_here
SMTP_FROM_EMAIL=hotro@tichsan.vn
SMTP_FROM_NAME=Tich San Support

# Google OAuth
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=production-google-client-secret
GOOGLE_CALLBACK_URL=https://tichsan.vn/api/auth/google/callback

# Facebook OAuth
FACEBOOK_OAUTH_ENABLED=true
FACEBOOK_APP_ID=production-facebook-app-id
FACEBOOK_APP_SECRET=production-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://tichsan.vn/api/auth/facebook/callback

# Subscription & Welcome Gift Policy
DEFAULT_PLAN_CODE=FREE
WELCOME_GIFT_PLAN_CODE=VIP_GOLD
WELCOME_GIFT_DAYS=30
FEATURE_TOPUP_ENABLED=false

# PayOS Payment Gateway & Legal Compliance Switch
# Chỉ bật thành true sau khi chủ sở hữu đã hoàn tất đăng ký kinh doanh và thuế
PAYMENTS_ENABLED=false
PAYOS_ENABLED=false
LEGAL_COMPLIANCE_APPROVED=false

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=https://tichsan.vn/api/payment/webhook

# Admin Bootstrap CLI Configuration
ADMIN_BOOTSTRAP_EMAIL=admin@tichsan.vn
ADMIN_BOOTSTRAP_COOLDOWN_DAYS=7

# Market Data
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# AI Analysis
AI_PROVIDER=gemini
AI_API_KEY=

# Object Storage
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_BUCKET=tichsan-production-assets
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Sentry
SENTRY_DSN=

